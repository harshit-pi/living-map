# Only the app is checked; commits that touch nothing under app/ pass straight through.
git diff --cached --name-only | grep -q '^app/' || exit 0
cd app || exit 1

echo "Running lint-staged (ESLint fix + Prettier on staged files)..."
npx lint-staged || { echo "❌ lint-staged failed. Commit aborted."; exit 1; }

echo "Running full app checks in parallel (ESLint, TypeScript, Prettier, Vitest)..."
# Each check writes its own exit code: a pipe's status is sed's, which passes.
STATUS=$(mktemp -d)
trap 'rm -rf "$STATUS"' EXIT
check() {
  name=$1
  shift
  {
    code=0
    "$@" 2>&1 || code=$?
    echo "$code" >"$STATUS/$name"
  } | sed "s/^/[$name] /"
}
check eslint npx eslint . --max-warnings=0 --cache &
check tsc npx tsc --noEmit &
check prettier npx prettier --check . --cache &
check vitest npx vitest run --silent &
wait

FAILED=0
[ "$(cat "$STATUS/eslint")" = 0 ] || { echo "❌ ESLint found errors."; FAILED=1; }
[ "$(cat "$STATUS/tsc")" = 0 ] || { echo "❌ TypeScript errors found."; FAILED=1; }
[ "$(cat "$STATUS/prettier")" = 0 ] || { echo "❌ Prettier formatting issues found."; FAILED=1; }
[ "$(cat "$STATUS/vitest")" = 0 ] || { echo "❌ Tests failed."; FAILED=1; }
[ $FAILED -eq 0 ] || { echo "Commit aborted due to errors above."; exit 1; }
echo "✅ All checks passed."
