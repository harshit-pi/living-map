{
  "name": "living-map-app",
  "private": true,
  "version": "0.1.0",
  "description": "Living Map: a visual canvas that drives your own Claude Code. Explore a question as a map, or learn any subject on a diagram you fill in and scenes you play by hand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshit-pi/living-map.git",
    "directory": "app"
  },
  "keywords": [
    "claude",
    "claude-code",
    "learning",
    "visualization",
    "diagram",
    "canvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "server": "node server/index.ts",
    "start": "vite build && node server/launcher.ts",
    "test": "vitest run",
    "ts": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "check": "eslint . --max-warnings=0 && tsc --noEmit && prettier --check . && vitest run",
    "skill": "node skill/install.ts",
    "eval": "node eval/forms.ts",
    "eval:moves": "node eval/moves.ts",
    "prepare": "cd .. && husky app/.husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
