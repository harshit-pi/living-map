{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": [
    "web",
    "shared",
    "server",
    "eval",
    "plugins",
    "layer",
    "skill",
    "vite.config.ts"
  ],
  "exclude": [
    "server/legacy-server.mjs",
    "server/core/legacy-lib.mjs",
    "server/core/legacy.test.mjs"
  ]
}
